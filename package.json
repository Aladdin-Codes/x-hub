{
  "name": "x-hub",
  "version": "0.9.7",
  "private": true,
  "type": "module",
  "description": "Local personal productivity workspace",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "prebuild": "node scripts/gen-settings-index.mjs",
    "build": "vue-tsc -b && vite build",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:build:nsis": "tauri build --bundles nsis",
    "tauri:test": "pwsh -NoLogo -NoProfile -File scripts/cargo-test.ps1",
    "test:utils": "node --test tests/*.test.mjs",
    "test:security": "node --test tests/security.test.mjs",
    "gen:settings-index": "node scripts/gen-settings-index.mjs",
    "check:settings-css": "node scripts/check-settings-css.mjs",
    "check:workspace": "node scripts/check-workspace-config.mjs"
  },
  "dependencies": {
    "@codemirror/language": "^6.11.0",
    "@codemirror/language-data": "^6.5.2",
    "@internationalized/date": "^3.12.3",
    "@milkdown/crepe": "^7.22.1",
    "@milkdown/kit": "^7.22.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@univerjs/preset-sheets-core": "^1.2.0",
    "@univerjs/presets": "^1.2.0",
    "dompurify": "^3.4.15",
    "exceljs": "^4.4.0",
    "lucide-vue-next": "^0.577.0",
    "marked": "^18.0.7",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "reka-ui": "^2.10.3",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.40"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^24.13.3",
    "@univerjs/core": "^1.2.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/tsconfig": "^0.9.1",
    "typescript": "~6.0.2",
    "unplugin-auto-import": "^21.0.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.2.0",
    "vue-tsc": "^3.3.8"
  }
}
