# Normalize text files to LF to avoid core.autocrlf status noise on Windows.
* text=auto eol=lf

# Keep Windows scripts in CRLF format.
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files.
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.icns binary
*.woff binary
*.woff2 binary
*.ttf binary
*.zip binary
*.exe binary
